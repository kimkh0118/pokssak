# 공공데이터 인증키는 서버에서만 사용합니다. 이 파일을 .env.local 로 복사해 값을 채우세요.
# .env.local 은 저장소에 올라가지 않습니다(.gitignore). 키 값을 코드·로그·이슈에 붙여 넣지 마세요.

# 1) 주소기반산업지원서비스(business.juso.go.kr) — 도로명주소 '검색 API' 승인키(confmKey)
JUSO_API_KEY=

# 2) 공공데이터포털(data.go.kr) 일반 인증키 — 'Decoding' 키를 넣으세요(서버에서 URL 인코딩함)
#    활용신청 필요: 국토교통부_건축HUB_건축물대장정보 서비스(15134735), 국토교통부_단독/다가구 매매 실거래가 자료(15126465)
DATA_GO_KR_SERVICE_KEY=

# 3) 브이월드(vworld.kr) 오픈API 인증키 — 국가중점데이터 '토지특성정보' 사용
VWORLD_API_KEY=
# 인증키 발급 시 등록한 서비스 URL(도메인). 필요할 때만 설정
VWORLD_DOMAIN=

# 선택: 공공 API 응답 대기 시간(ms), SQLite 파일 경로
PUBLIC_API_TIMEOUT_MS=10000
DATABASE_PATH=./data/app.db
