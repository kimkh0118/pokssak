{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "백엔드 (FastAPI :8000)",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": ["app.main:app", "--reload", "--port", "8000"],
      "cwd": "${workspaceFolder}/backend",
      "python": "${workspaceFolder}/backend/.venv/bin/python",
      "jinja": false
    },
    {
      "name": "프런트엔드 (Next.js :3000)",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm run dev",
      "cwd": "${workspaceFolder}/frontend"
    }
  ],
  "compounds": [
    { "name": "전체 실행 (백엔드 + 프런트엔드)", "configurations": ["백엔드 (FastAPI :8000)", "프런트엔드 (Next.js :3000)"] }
  ]
}
