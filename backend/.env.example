# 서버 전용 비밀값. 이 파일을 backend/.env 로 복사해 채우세요. .env 는 저장소에 올라가지 않습니다(.gitignore).

# ---- 공공 API: 인증키 3종 ----
# 1) 주소기반산업지원서비스(business.juso.go.kr) — 도로명주소 '검색 API' 승인키
JUSO_API_KEY=
# 2) 공공데이터포털(data.go.kr) 일반 인증키(Decoding). 아래 3개 서비스를 각각 활용신청해야 함
#    건축HUB 건축물대장정보(15134735) · 단독/다가구 매매 실거래가(15126465) · 토지 매매 실거래가(15126466)
DATA_GO_KR_SERVICE_KEY=
# 3) 브이월드(vworld.kr) 인증키 — 토지특성·토지이용계획·개별주택가격. 발급 때 등록한 서비스 URL 을 VWORLD_DOMAIN 에(Referer 로 전송)
VWORLD_API_KEY=
VWORLD_DOMAIN=http://localhost:3000
PUBLIC_API_TIMEOUT_SECONDS=10

# ---- 운영 ----
# 이 이메일로 로그인하면 관리자 권한
ADMIN_EMAILS=
# DATABASE_PATH=backend/data/app.db
# 배포용 Turso(있으면 위 파일 대신 사용)
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=
# FRONTEND_ORIGIN=http://localhost:3000

# ---- 로그인 ----
# 구글 로그인. 승인된 리디렉션 URI: http://localhost:3000/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- 선택: AI 추천 설명. 없으면 규칙 기반 설명으로 동작 ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
