# 서버 전용 비밀값. 이 파일을 backend/.env 로 복사해 채우세요. .env 는 저장소에 올라가지 않습니다(.gitignore).

# ---- 공공 API: 서비스 6개, 인증키 3종 ----
# 1) 주소기반산업지원서비스(business.juso.go.kr) — 도로명주소 '검색 API' 승인키
JUSO_API_KEY=
# 2) 공공데이터포털(data.go.kr) 일반 인증키(Decoding). 아래 3개 서비스를 각각 활용신청해야 함
#    건축HUB 건축물대장정보(15134735) · 단독/다가구 매매 실거래가(15126465) · 토지 매매 실거래가(15126466)
DATA_GO_KR_SERVICE_KEY=
# 3) 브이월드(vworld.kr) 인증키 — 토지특성정보·토지이용계획정보. 발급 때 등록한 서비스 URL 을 VWORLD_DOMAIN 에(Referer 로 전송)
VWORLD_API_KEY=
VWORLD_DOMAIN=http://localhost:3000
PUBLIC_API_TIMEOUT_SECONDS=10

# ---- 운영 ----
# 이 이메일로 가입하면 관리자(공고 검토·발행·수집 작업)
ADMIN_EMAILS=
# 지원사업 주간 수집(한국 시간). 요일 MON~SUN + HH:MM
PROGRAM_SCHEDULE=MON 09:00
SCHEDULER_ENABLED=1
# 처음 실행 시 예시 지원사업 등록(1) / 안 함(0)
SEED_SAMPLE=1
# DATABASE_PATH=backend/data/app.db
# FRONTEND_ORIGIN=http://localhost:3000

# ---- 선택: LLM(공고 구조화·추천 설명). 없으면 예시 추출기와 규칙 기반 설명으로 동작 ----
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5

# ---- 선택: 외부 알림 발송 공급자(없으면 앱 내 알림함만). 알림 JSON 을 POST 로 받는 주소 ----
EMAIL_PROVIDER_URL=
SMS_PROVIDER_URL=
PUSH_PROVIDER_URL=
